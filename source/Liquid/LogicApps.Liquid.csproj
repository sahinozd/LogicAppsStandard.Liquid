<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LogicApps.Liquid</PackageId>
    <Authors>Sahin Ozdemir</Authors>
    <Description>Validates and runs Liquid maps exactly like the Azure Logic Apps Standard Liquid action: same DotLiquid build, naming convention, custom tags, input wrapping and output parsing.</Description>
    <PackageTags>logicapps;azure;integration;liquid;dotliquid;transform;validation</PackageTags>
    <PackageProjectUrl>https://github.com/sahinozd/LogicAppsStandard.Liquid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sahinozd/LogicAppsStandard.Liquid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned on purpose: these are the exact versions shipped in the Logic Apps Standard workflow runtime (extension bundle Microsoft.Azure.Functions.ExtensionBundle.Workflows 1.170.x).
         The DotLiquid netstandard1.3 binary is byte-identical to the one in the runtime. Do not upgrade without re-running the conformance tests. -->
    <PackageReference Include="DotLiquid" Version="[2.0.361]" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.3]" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogicApps.Liquid.Tests" />
    <InternalsVisibleTo Include="LogicApps.Liquid.ConformanceTests" />
  </ItemGroup>

</Project>
